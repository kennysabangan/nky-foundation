---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import { siteConfig } from '../../config';

const { businessName, phone, phoneE164, siteUrl, serviceKeyword, serviceKeywordPlural, city, region, services, cities } = siteConfig;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase()),
  "provider": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": phoneE164,
  },
  "areaServed": siteConfig.cities.map((c) => ({ "@type": "City", "name": c.name })),
  "description": `Professional ${serviceKeywordPlural} for residential and commercial properties in ${city}.`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteUrl}/foundation/` },
  ],
};
---

<BaseLayout
  title="Foundation Repair & Waterproofing | Cincinnati & Northern KY"
  description={`Foundation crack repair, piering, wall anchors, and basement waterproofing in Cincinnati & Northern Kentucky. Free inspection: ${phone}.`}
  canonicalURL={`${siteUrl}/foundation/`}
  schema={[breadcrumbSchema, serviceSchema]}
>

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <h1>Foundation Repair &amp; Basement Waterproofing Services</h1>
    <p class="hero-sub">Residential and commercial {serviceKeyword} and basement waterproofing in {city} and the Greater Cincinnati area.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Photo -->
<div class="container py-6 text-center">
  <img
    src="/photos/hero.jpg"
    alt={`${serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} services in ${city}`}
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<!-- Services -->
<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">Our {serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} Services</h2>

  <p>{businessName} provides professional {serviceKeywordPlural} throughout {city}. We repair foundations on homes, offices, and commercial buildings. Here are the {serviceKeywordPlural} we offer:</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 my-8">
    {services.map((service) => (
      <div class="service-card">
        {service.photo && <img src={service.photo} alt={`${service.title} — ${businessName}`} loading="lazy" />}
        <div class="card-body">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 id="basement-waterproofing" class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Basement Waterproofing</h2>

  <p>A wet basement usually traces back to one of a few sources: rain and roof runoff draining toward the house, groundwater pressing against the walls and floor, or a crack or joint that gives that water a way in. The right fix depends on where the water is coming from, so we start by looking at the grading, gutters, and downspouts outside and at where the water shows up inside.</p>

  <p><strong>Exterior grading and downspout extensions.</strong> When water pools against the foundation after storms, the first step is often the simplest: regrading the soil so it slopes away from the house and extending downspouts so roof water is released well away from the walls. It is the least invasive option and is worth doing before, or alongside, any interior work.</p>

  <p><strong>Interior drain tile and sump pump.</strong> When water seeps in where the wall meets the floor, or the basement takes on water in wet seasons even with good grading, an interior perimeter drain can collect it under the floor along the walls and carry it to a sump pump that discharges it outside. This system manages water that reaches the wall rather than stopping it at the surface, so it depends on a working pump; a battery backup is worth considering.</p>

  <p><strong>Crack injection and wall sealing.</strong> When water comes through a specific crack in a poured concrete wall, injecting the crack with polyurethane or epoxy can seal that leak. Waterproof coatings on interior walls can help with dampness and light seepage, but they are not designed to hold back water under pressure; for block walls or recurring leaks, drainage is usually the more reliable approach.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How Our {serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} Service Works</h2>

  <p>Getting your foundation repaired by {businessName} is easy. Here's how it works:</p>

  <p><strong>Step 1: Call Us.</strong> Give us a call at {phone} and tell us about the foundation issues you're experiencing. We'll ask about the symptoms you're seeing — cracks, settling, bowing walls, water intrusion.</p>

  <p><strong>Step 2: Free Inspection and Estimate.</strong> We look at the cracks, floors, and walls, find the likely cause, and give you a written estimate that explains the recommended repair and its price before any work starts.</p>

  <p><strong>Step 3: We Make the Repair.</strong> Our team arrives on time with all the equipment and supplies needed to repair your foundation. We work efficiently and treat your property with respect.</p>

  <p><strong>Step 4: Final Walk-Through.</strong> When the work is done, we walk through the repair with you, explain what was installed and what to watch for, and leave the work area clean.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">{serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} Service Areas</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/foundation/${c.slug}/`}>{serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} in {c.name}</a></li>
    ))}
  </ul>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Fix Your Foundation?</p>
    <p class="cta-sub">Call now for a free {serviceKeyword} inspection in {city}.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Final CTA -->
<section class="bg-brand-dark text-white">
  <div class="cta-strip container">
    <h2 class="text-white text-xl md:text-2xl font-bold mb-2">Call Now for {serviceKeyword.replace(/\b\w/g, (m) => m.toUpperCase())} in {city}</h2>
    <p class="text-white/90 text-base mb-4">We provide {serviceKeywordPlural} across {region}.</p>
    <PhoneCTA label="Call Now" />
  </div>
</section>

</BaseLayout>
