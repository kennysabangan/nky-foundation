---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, serviceKeywordPlural, city, region, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides foundation crack repair, piering, and bowing wall repair in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`About ${businessName}: foundation crack repair, piering, bowing wall repair, and basement waterproofing across Northern Kentucky.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<!-- Hero -->
<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Foundation repair for Northern Kentucky homes and businesses.</p>
    <PhoneCTA />
  </div>
</section>

<!-- Photo -->
<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt={`${businessName} team`}
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<!-- About content -->
<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>{businessName} provides {serviceKeywordPlural} on homes and commercial buildings across {region}. Most of the work comes down to a few problems: cracked foundation walls, settling, basement walls bowing inward under soil pressure, and water getting into the basement.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <img
    src="/photos/residential.jpg"
    alt={`${serviceKeyword.charAt(0).toUpperCase() + serviceKeyword.slice(1)} in ${city}`}
    class="site-photo mx-auto max-w-lg my-6"
    loading="lazy"
  />

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Inspection.</strong> Call {phone} or send the form. We look at the cracks, floors, and walls, check drainage around the house, and work out what's most likely causing the damage.</p>

  <p><strong>2. Written estimate.</strong> You get the recommended repair, what it is meant to do, and the price in writing before any work starts. No obligation.</p>

  <p><strong>3. Repair and walk-through.</strong> Most repairs take one to three days; larger piering jobs can take up to a week. When the work is done, we walk through it with you and leave the work area clean.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas in Boone, Kenton, and Campbell counties:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/foundation/${c.slug}/`}>Foundation repair in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask.</p>
</div>

<!-- CTA -->
<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Fix Your Foundation?</p>
    <p class="cta-sub">Call now for a free inspection.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
